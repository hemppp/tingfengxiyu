# NovelMuse Agents 微服务环境变量样例
# 复制为 .env 并按需修改

# 服务端口（与前端 5174、TS 后端 3774 形成 74 系列）
AGENTS_PORT=3775

# 默认 AI Provider（仅当 TS 后端未在请求中携带 config 时使用）
AI_PROVIDER=openai

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Custom（中转站 / DeepSeek / 通义千问等）
CUSTOM_AI_BASE_URL=https://api.openai.com/v1
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=gpt-4-turbo
