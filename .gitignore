# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.vite/

# Database files (IMPORTANT: 防止数据丢失)
*.db
*.db-journal
*.db-wal
*.db-shm
data/*.db
data/*.bak
data/*.db.bak*
# data/ 全部是运行时产物（SQLite、用户稿件 projects/、账号备份），一律不入库
/data/
# 整库备份目录与发布产物
data-backup-*/
/release/

# 开发环境持久化的 JWT 签名密钥（敏感，严禁提交）
data/.jwt-secret
.jwt-secret

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Testing
coverage/
.nyc_output/

# Temporary files
.tmp/
.cache/

# OS files
Thumbs.db

# Development logs
.dev-*.log
diagnose.html

# AI reasoning / planning cache
.reasonix/
.plan/
.codex/
.recon/
.workbuddy/
.zcode/
.mimosa/
.uploads/
apps/web/.mimosa/
apps/web/.tmp-build/

# 临时调试产物（根目录杂散文件）
.s0.js
.s1.js
.tmp-*.txt

# Current session logs (live, in-use by dev server)
# .dev-server.log and .dev-web.log are added here
# but currently open by running processes
.dev-server.log
.dev-web.log

# Python (apps/agents)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
apps/agents/.env

# dev hidden launcher runtime files
.run-*.log
.run-*.pid
.fix-*.log
.fix-*.pid
.verify-*.log
.verify-*.pid
.install.log

# 外部工具生成的图谱产物（可重新生成）
graphflow-out/

# playwright 调试会话产物（console/page 快照）
.playwright-cli/

# 设计评审会话截图与演示产物
